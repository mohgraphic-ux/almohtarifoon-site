[Unit]
Description=Almohtarifoon website
After=network.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- --port __PORT__
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
